# vkb-hotas configuration (systemd EnvironmentFile).
# Comments must be on their own line; a "# ..." after a value becomes part of it.
# After editing: sudo ./install.sh   (or: sudo systemctl restart vkb-hotas)

# Real stick to remap, as VID:PID (see: sudo ./install.sh --list).
VKB_HOTAS_DEVICE=""

# Desktop user allowed to remap with vkb-mapper (owns the control socket and
# ~USER/.config/vkb-hotas/mapping.json). install.sh fills in the sudo caller.
VKB_HOTAS_USER=""

# Extra daemon arguments (see: /usr/local/lib/vkb-hotas/vkb-hotas.py --help).
# Axis/button options here only set the built-in default profile: once you save a
# mapping in vkb-mapper, the mapping file's active profile takes precedence. Examples:
#VKB_HOTAS_ARGS="--button-count 32"
#VKB_HOTAS_ARGS="--button-count 32 --invert SLIDER"
#VKB_HOTAS_ARGS="--axis SLIDER=ABS_RX --axis RZ=ABS_Z"
VKB_HOTAS_ARGS=""
