# vkb-hotas: re-present a flight stick (@VID@:@PID@) to games as a T.16000M.
# Generated by install.sh. Must sort after 70-uaccess.rules / any vendor rule
# granting uaccess, and before 73-seat-late.rules (which applies the ACLs).

# Start the remapper whenever the real stick appears (boot coldplug included).
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="@VID@", ATTRS{idProduct}=="@PID@", TAG+="systemd", ENV{SYSTEMD_WANTS}+="vkb-hotas.service"

# While the remapper runs, hide the real stick from user sessions (Steam,
# Proton/Wine, browsers) so games see only the virtual stick.
TEST=="/run/vkb-hotas/active", SUBSYSTEM=="input", KERNEL=="event*|js*", ATTRS{idVendor}=="@VID@", ATTRS{idProduct}=="@PID@", TAG-="uaccess", MODE="0600"
TEST=="/run/vkb-hotas/active", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="@VID@", ATTRS{idProduct}=="@PID@", TAG-="uaccess", MODE="0600"

# The virtual T.16000M is a uhid device with no USB parent: give the seat user
# access to its hidraw node so Wine's hidraw backend can open it.
SUBSYSTEM=="hidraw", KERNELS=="0003:044F:B10A.*", MODE="0660", TAG+="uaccess"
